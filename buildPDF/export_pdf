def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Export NST wiki PDFs through one public command. "
            "Defaults to the full-wiki preset with all sections, Tool Index, and tool pages."
        )
    )
    parser.add_argument(
        "mode",
        nargs="?",
        choices=sorted(DEFAULT_PARTS_BY_MODE),
        default="full-wiki",
        help="Named preset to export (default: %(default)s).",
    )
    parser.add_argument(
        "--sections",
        action="append",
        default=[],
        metavar="NAME[,NAME...]",
        help=(
            "Export parts to include. Available: cover, about-installation, "
            "technical-specs, menu, toc, tool-pages, special-thanks, contacts. "
            "Omit to use the selected preset. Use 'none' to clear the preset and "
            "build only the explicitly listed parts."
        ),
    )
    parser.add_argument(
        "--tool-category",
        action="append",
        default=[],
        metavar="NAME[,NAME...]",
        help=(
            "Limit tool pages to one or more categories such as draw, filter, "
            "transform, 3d, cg, curves, utilities, or color."
        ),
    )
    parser.add_argument(
        "--version",
        default=WIKI_PDF.DEFAULT_VERSION,
        help="Release string used in the PDF cover subtitle and output filename (default: %(default)s).",
    )
    parser.add_argument(
        "--output-dir",
        default=None,
        help=f"Directory for output PDFs (default: repo-local {DEFAULT_OUTPUT_DIR_LABEL}).",
    )
    parser.add_argument(
        "--open",
        action="store_true",
        help="Open the compressed PDF after building when available; otherwise open the normal output.",
    )
    parser.add_argument(
        "--no-compress",
        action="store_true",
        help="Skip the default Ghostscript compression step and emit only the normal PDF.",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Show underlying renderer command output.",
    )
    parser.add_argument(
        "--no-cache",
        action="store_true",
        help="Disable the local PDF bundle cache for this export run.",
    )
    parser.add_argument(
        "--refresh-cache",
        action="store_true",
        help="Rebuild selected cached bundles before assembling the export.",
    )
    return parser.parse_args()


def normalize_sections(raw_sections: list[str]) -> list[str] | None:
    if not raw_sections:
        return None

    seen: set[str] = set()

    for raw in raw_sections:
        for part in raw.split(","):
            token = part.strip().lower()
            if not token:
                continue
            if token in {"none", "no", "empty"}:
                seen.clear()
                continue
            if token in {"all", "*"}:
                seen = set(EXPORT_PARTS)
                continue

            normalized = SECTION_ALIASES.get(token, token)
            if normalized not in EXPORT_PARTS:
                valid = ", ".join(EXPORT_PARTS)
                raise SystemExit(f"ERROR: unknown section '{token}'. Valid sections: {valid}")
            if normalized in seen:
                continue
            seen.add(normalized)

    ordered_sections = [section for section in EXPORT_PARTS if section in seen]
    if ordered_sections:
        return ordered_sections
    return []


def resolve_selection(args: argparse.Namespace) -> tuple[list[str], list[str], bool, bool, list[str]]:
    selected_sections = normalize_sections(args.sections)
    tool_categories = TOOL_PDF.normalize_categories(args.tool_category)

    if selected_sections is None:
        export_parts = list(DEFAULT_PARTS_BY_MODE[args.mode])
    else:
        export_parts = selected_sections

    include_tool_pages = "tool-pages" in export_parts
    include_toc = "toc" in export_parts
    non_tool_parts = [part for part in NON_TOOL_EXPORT_PARTS if part in export_parts]
    sections = [PART_TO_INTERNAL_SECTION[part] for part in non_tool_parts]

    if include_toc and not include_tool_pages:
        raise SystemExit("ERROR: 'toc' requires 'tool-pages' to be selected as well.")

    if tool_categories and not include_tool_pages:
        raise SystemExit("ERROR: --tool-category requires 'tool-pages' to be selected.")

    if not export_parts:
        raise SystemExit("ERROR: nothing selected to export.")

    return export_parts, sections, include_tool_pages, include_toc, tool_categories


def normalize_version_label(raw_version: str) -> str:
    version = raw_version.strip()
    if not version:
        raise SystemExit("ERROR: --version cannot be empty.")
    if version[0] in {"v", "V"}:
        return f"v{version[1:]}"
    return f"v{version}"


def resolve_output_dir(raw_output_dir: str | None) -> Path:
    if raw_output_dir is None:
        return DEFAULT_OUTPUT_DIR
    output_dir = Path(raw_output_dir).expanduser()
    if not output_dir.is_absolute():
        output_dir = Path.cwd() / output_dir
    return output_dir.resolve()


def default_cache_manifest() -> dict:
    return {"schema": CACHE_SCHEMA_VERSION, "bundles": {}}


def load_cache_manifest() -> dict:
    if not CACHE_MANIFEST_PATH.is_file():
        return default_cache_manifest()
    try:
        manifest = json.loads(CACHE_MANIFEST_PATH.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return default_cache_manifest()
    if manifest.get("schema") != CACHE_SCHEMA_VERSION or not isinstance(manifest.get("bundles"), dict):
        return default_cache_manifest()
    return manifest


def save_cache_manifest(manifest: dict) -> None:
    CACHE_ROOT.mkdir(parents=True, exist_ok=True)
    CACHE_MANIFEST_PATH.write_text(json.dumps(manifest, indent=2, sort_keys=True), encoding="utf-8")


def expand_input_paths(paths: list[Path] | tuple[Path, ...]) -> list[Path]:
    expanded: list[Path] = []
    seen: set[Path] = set()
    for path in paths:
        if path.is_dir():
            for child in sorted(candidate for candidate in path.rglob("*") if candidate.is_file()):
                if child not in seen:
                    expanded.append(child)
                    seen.add(child)
        elif path.is_file() and path not in seen:
            expanded.append(path)
            seen.add(path)
    return expanded


def normalize_local_asset_ref(raw_ref: str) -> str | None:
    ref = raw_ref.strip().strip("\"'")
    if not ref:
        return None
    if ref.startswith("<") and ref.endswith(">"):
        ref = ref[1:-1].strip()
    if " " in ref and not ref.startswith(("data:", "http://", "https://")):
        ref = ref.split(" ", 1)[0]
    if not ref or ref.startswith(("#", "data:", "http://", "https://", "mailto:", "tel:", "javascript:", "//")):
        return None
    if "{" in ref or "}" in ref or "__" in ref:
        return None
    ref = ref.split("#", 1)[0].split("?", 1)[0].strip()
    if not ref:
        return None
    return ref


def local_asset_dependencies(paths: list[Path] | tuple[Path, ...]) -> list[Path]:
    dependencies: list[Path] = []
    seen: set[Path] = set()
    for source_path in expand_input_paths(paths):
        if source_path.suffix.lower() not in {".md", ".html", ".j2", ".css"}:
            continue
        try:
            text = source_path.read_text(encoding="utf-8")
        except OSError:
            continue
        raw_refs = list(MARKDOWN_IMAGE_RE.findall(text))
        raw_refs.extend(HTML_SRC_RE.findall(text))
        raw_refs.extend(CSS_URL_RE.findall(text))
        for raw_ref in raw_refs:
            normalized_ref = normalize_local_asset_ref(raw_ref)
            if normalized_ref is None:
                continue
            candidate = (source_path.parent / normalized_ref).resolve()
            try:
                candidate.relative_to(REPO_ROOT)
            except ValueError:
                continue
            if not candidate.exists() or candidate in seen:
                continue
            dependencies.append(candidate)
            seen.add(candidate)
    return dependencies


def mkdocs_config_without_nav() -> dict[str, object]:
    config = WIKI_PDF.load_base_config()
    if not isinstance(config, dict):
        return {}
    normalized = dict(config)
    normalized.pop("nav", None)
    return normalized


def signature_for_paths(paths: list[Path] | tuple[Path, ...], *, extras: dict[str, object]) -> str:
    hasher = hashlib.sha256()
    for path in expand_input_paths(paths):
        try:
            rel_path = path.relative_to(REPO_ROOT)
        except ValueError:
            rel_path = path
        stat = path.stat()
        hasher.update(str(rel_path).encode("utf-8"))
        hasher.update(str(stat.st_size).encode("utf-8"))
        hasher.update(str(stat.st_mtime_ns).encode("utf-8"))
    hasher.update(json.dumps(extras, sort_keys=True).encode("utf-8"))
    return hasher.hexdigest()


def section_cache_key(section: str, *, version: str) -> str:
    return f"section:{section}:{normalize_version_label(version)}"


def section_cache_path(section: str) -> Path:
    return SECTION_CACHE_DIR / f"{section}.pdf"


def tool_cache_key(slug: str, *, version: str) -> str:
    return f"tool-category:{slug}:{normalize_version_label(version)}"


def tool_cache_pdf_path(slug: str) -> Path:
    return TOOL_CACHE_DIR / f"{slug}.pdf"


def tool_cache_meta_path(slug: str) -> Path:
    return TOOL_CACHE_DIR / f"{slug}.json"


def selected_tool_category_records(categories: list[str]) -> list[dict[str, object]]:
    records: list[dict[str, object]] = []
    for record in TOOL_PDF.selected_tool_category_records(categories):
        entry = record["entry"]
        entry_value = next(iter(entry.values()))
        tool_docs = [
            path
            for path in WIKI_PDF.nav_leaf_doc_paths(entry_value)
            if path.name != "index.md"
        ]
        records.append(
            {
                "entry": entry,
                "slug": record["slug"],
                "title": record["title"],
                "tool_docs": tool_docs,
                "tool_titles": [WIKI_PDF.first_markdown_heading(path) for path in tool_docs],
            }
        )
    return records


def section_signature(section: str, *, version: str) -> str:
    inputs = list(COMMON_SECTION_INPUTS)
    extras: dict[str, object] = {"section": section, "version": normalize_version_label(version)}
    if section == "cover":
        inputs.extend(
            [
                REPO_ROOT / "documentation" / "templates" / "cover.html.j2",
                REPO_ROOT / "documentation" / "docs" / "img" / "pdf" / "NukeSurvivalToolkit_Splashpage_cover.jpg",
            ]
        )
        extras["pdf_config"] = mkdocs_config_without_nav()
    else:
        content_doc = SECTION_CONTENT_DOCS.get(section)
        template_path = SECTION_TEMPLATE_PATHS.get(section)
        if content_doc is not None:
            inputs.append(content_doc)
            inputs.extend(local_asset_dependencies([content_doc]))
        if template_path is not None:
            inputs.append(template_path)
            inputs.extend(local_asset_dependencies([template_path]))
    return signature_for_paths(inputs, extras=extras)


def tool_category_signature(category_record: dict[str, object], *, version: str) -> str:
    slug = str(category_record["slug"])
    inputs = list(COMMON_TOOL_INPUTS)
    inputs.append(REPO_ROOT / "documentation" / "docs" / slug)
    tool_img_dir = REPO_ROOT / "documentation" / "docs" / "img" / "tools" / slug
    if tool_img_dir.exists():
        inputs.append(tool_img_dir)
    tool_docs = category_record.get("tool_docs") or []
    if tool_docs:
        inputs.extend(local_asset_dependencies(tool_docs))
    return signature_for_paths(
        inputs,
        extras={
            "slug": slug,
            "title": category_record["title"],
            "entry": category_record["entry"],
            "pdf_config": mkdocs_config_without_nav(),
            "version": normalize_version_label(version),
        },
    )


def build_tool_category_metadata(pdf_path: Path, category_record: dict[str, object]) -> dict:
    pages = WIKI_PDF.pdf_pages_text(pdf_path)
    tool_relative_page_map = {
        title: WIKI_PDF.page_for_title(title, pages)
        for title in category_record["tool_titles"]
    }
    return {
        "slug": category_record["slug"],
        "title": category_record["title"],
        "page_count": WIKI_PDF.page_count(pdf_path),
        "tool_titles": category_record["tool_titles"],
        "tool_relative_page_map": tool_relative_page_map,
    }


def resolve_section_bundle(
    section: str,
    *,
    version: str,
    working_dir: Path,
    use_cache: bool,
    refresh_cache: bool,
    manifest: dict,
    playwright_python: str,
    verbose: bool,
) -> tuple[Path, int, bool]:
    signature = section_signature(section, version=version)
    cache_key = section_cache_key(section, version=version)
    cache_path = section_cache_path(section)
    cache_entry = manifest["bundles"].get(cache_key)

    if use_cache and not refresh_cache and cache_entry and cache_entry.get("signature") == signature and cache_path.is_file():
        print(f"Section cache hit: {section}")
        page_count = int(cache_entry.get("page_count") or WIKI_PDF.page_count(cache_path))
        return cache_path, page_count, False

    print(f"Section cache miss: {section}")
    target_path = cache_path if use_cache else working_dir / f"{section}.pdf"
    target_path.parent.mkdir(parents=True, exist_ok=True)
    build_section_pdf(
        section,
        output_path=target_path,
        version=version,
        playwright_python=playwright_python,
        verbose=verbose,
    )
    page_total = WIKI_PDF.page_count(target_path)
    if use_cache:
        manifest["bundles"][cache_key] = {"signature": signature, "page_count": page_total}
    return target_path, page_total, use_cache


def resolve_tool_category_bundles(
    *,
    category_records: list[dict[str, object]],
    version: str,
    working_dir: Path,
    use_cache: bool,
    refresh_cache: bool,
    manifest: dict,
    playwright_python: str,
    verbose: bool,
) -> tuple[list[dict[str, object]], bool]:
    resolved: dict[str, dict[str, object]] = {}
    stale_records: list[tuple[dict[str, object], str]] = []
    manifest_changed = False

    for record in category_records:
        slug = str(record["slug"])
        signature = tool_category_signature(record, version=version)
        cache_key = tool_cache_key(slug, version=version)
        cache_pdf = tool_cache_pdf_path(slug)
        cache_meta = tool_cache_meta_path(slug)
        cache_entry = manifest["bundles"].get(cache_key)
        if use_cache and not refresh_cache and cache_entry and cache_entry.get("signature") == signature and cache_pdf.is_file() and cache_meta.is_file():
            print(f"Tool bundle cache hit: {slug}")
            resolved[slug] = {
                "slug": slug,
                "title": record["title"],
                "pdf_path": cache_pdf,
                "metadata": json.loads(cache_meta.read_text(encoding="utf-8")),
            }
            continue
        print(f"Tool bundle cache miss: {slug}")
        stale_records.append((record, signature))

    if stale_records:
        build_output_dir = working_dir / "tool-category-build"
        built = dict(
            TOOL_PDF.build_tool_category_pdfs(
                categories=[str(record["slug"]) for record, _signature in stale_records],
                version=version,
                output_dir=build_output_dir,
                playwright_python=playwright_python,
                verbose=verbose,
            )
        )

        for record, signature in stale_records:
            slug = str(record["slug"])
            built_pdf = built[slug]
            metadata = build_tool_category_metadata(built_pdf, record)
            if use_cache:
                cache_pdf = tool_cache_pdf_path(slug)
                cache_meta = tool_cache_meta_path(slug)
                cache_pdf.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(built_pdf, cache_pdf)
                cache_meta.write_text(json.dumps(metadata, indent=2, sort_keys=True), encoding="utf-8")
                manifest["bundles"][tool_cache_key(slug, version=version)] = {
                    "signature": signature,
                    "page_count": metadata["page_count"],
                }
                manifest_changed = True
                resolved[slug] = {
                    "slug": slug,
                    "title": record["title"],
                    "pdf_path": cache_pdf,
                    "metadata": metadata,
                }
            else:
                resolved[slug] = {
                    "slug": slug,
                    "title": record["title"],
                    "pdf_path": built_pdf,
                    "metadata": metadata,
                }

    ordered = [resolved[str(record["slug"])] for record in category_records]
    return ordered, manifest_changed


def filename_suffix_components(
    *,
    export_parts: list[str],
    include_tool_pages: bool,
    include_toc: bool,
    tool_categories: list[str],
) -> list[str]:
    non_tool_parts = [part for part in NON_TOOL_EXPORT_PARTS if part in export_parts]
    has_all_non_tool_parts = non_tool_parts == list(NON_TOOL_EXPORT_PARTS)
    is_full_wiki = include_tool_pages and include_toc and has_all_non_tool_parts and not tool_categories

    if is_full_wiki:
        return []
    if export_parts == ["tool-pages"] and not tool_categories:
        return ["tools-only"]
    if not include_tool_pages and has_all_non_tool_parts:
        return ["non-tools-only"]

    suffixes: list[str] = []

    if non_tool_parts and not has_all_non_tool_parts:
        suffixes.append(f"sections-{'-'.join(non_tool_parts)}")

    if include_toc and not (include_tool_pages and has_all_non_tool_parts):
        suffixes.append("toc")

    if include_tool_pages:
        if tool_categories:
            suffixes.append(f"tool-categories-{'-'.join(tool_categories)}")
        elif export_parts != ["tool-pages"]:
            suffixes.append("tool-pages")

    if not suffixes:
        suffixes.append("custom-export")

    return suffixes


def unique_output_path(output_dir: Path, stem: str) -> Path:
    candidate = output_dir / f"{stem}.pdf"
    if not candidate.exists():
        return candidate

    index = 1
    while True:
        candidate = output_dir / f"{stem}__{index:02d}.pdf"
        if not candidate.exists():
            return candidate
        index += 1


def compressed_output_path_for(output_path: Path) -> Path:
    """Return a unique sibling path for the compressed PDF artifact."""

    return unique_output_path(output_path.parent, f"{output_path.stem}__{COMPRESSED_SUFFIX}")


def ghostscript_binary() -> str | None:
    """Return the Ghostscript executable on PATH, if available."""

    return shutil.which("gs")


def require_ghostscript() -> str:
    """Return the Ghostscript executable or exit with an actionable error."""

    gs = ghostscript_binary()
    if gs is None:
        raise SystemExit(
            "ERROR: PDF compression is enabled by default, but Ghostscript ('gs') was not found on PATH. "
            "Install Ghostscript locally or rerun with --no-compress."
        )
    return gs


def format_file_size(size_bytes: int) -> str:
    """Format a byte count using base-1024 units for console reporting."""

    size = float(size_bytes)
    units = ("B", "KB", "MB", "GB", "TB")
    unit_index = 0
    while size >= 1024 and unit_index < len(units) - 1:
        size /= 1024
        unit_index += 1
    if unit_index == 0:
        return f"{int(size)} {units[unit_index]}"
    return f"{size:.1f} {units[unit_index]}"


def compression_summary(before_bytes: int, after_bytes: int) -> str:
    """Summarize the before/after size delta for a compression run."""

    if before_bytes <= 0:
        return f"{format_file_size(after_bytes)}"

    delta = after_bytes - before_bytes
    percent = abs(delta) / before_bytes * 100
    if delta <= 0:
        return (
            f"{format_file_size(before_bytes)} -> {format_file_size(after_bytes)} "
            f"({percent:.1f}% smaller)"
        )
    return (
        f"{format_file_size(before_bytes)} -> {format_file_size(after_bytes)} "
        f"({percent:.1f}% larger)"
    )


def compress_pdf(
    source_path: Path,
    output_path: Path,
    *,
    ghostscript_path: str,
    verbose: bool,
) -> Path:
    """Rewrite a PDF through Ghostscript using the tuned local compression profile."""

    # Force image recompression/downsampling for color and gray assets; in testing
    # this was the biggest lever for matching the older iLovePDF size band.
    command = [
        ghostscript_path,
        "-sDEVICE=pdfwrite",
        "-dCompatibilityLevel=1.4",
        "-dNOPAUSE",
        "-dBATCH",
        "-dSAFER",
        "-dDetectDuplicateImages=true",
        "-dCompressFonts=true",
        "-dSubsetFonts=true",
        "-dPDFSETTINGS=/screen",
        "-dAutoRotatePages=/None",
        "-dDownsampleColorImages=true",
        "-dColorImageDownsampleType=/Bicubic",
        f"-dColorImageResolution={COMPRESSION_IMAGE_DPI}",
        "-dColorImageDownsampleThreshold=1.0",
        "-dAutoFilterColorImages=false",
        "-dColorImageFilter=/DCTEncode",
        "-dDownsampleGrayImages=true",
        "-dGrayImageDownsampleType=/Bicubic",
        f"-dGrayImageResolution={COMPRESSION_IMAGE_DPI}",
        "-dGrayImageDownsampleThreshold=1.0",
        "-dAutoFilterGrayImages=false",
        "-dGrayImageFilter=/DCTEncode",
        "-dDownsampleMonoImages=true",
        "-dMonoImageDownsampleType=/Subsample",
        f"-dMonoImageResolution={COMPRESSION_MONO_DPI}",
        f"-sOutputFile={output_path}",
        str(source_path),
    ]
    if not verbose:
        command.insert(5, "-dQUIET")

    try:
        subprocess.run(
            command,
            check=True,
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None if verbose else subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError as exc:
        raise SystemExit(
            f"ERROR: Ghostscript compression failed for {source_path}. "
            "The normal PDF output remains available."
        ) from exc

    return output_path


def finalize_outputs(
    *,
    source_pdf_path: Path,
    output_path: Path,
    compressed_output_path: Path | None,
    ghostscript_path: str | None,
    toc_spec: dict | None,
    playwright_python: str,
    verbose: bool,
) -> ExportResult:
    """Write the normal PDF, optionally write the compressed sibling, and add TOC links."""

    if source_pdf_path != output_path:
        shutil.copyfile(source_pdf_path, output_path)

    if toc_spec is not None:
        WIKI_PDF.add_toc_links_and_outline(
            pdf_path=output_path,
            spec=toc_spec,
            playwright_python=playwright_python,
            verbose=verbose,
        )

    if compressed_output_path is None:
        return ExportResult(output_path=output_path)

    if ghostscript_path is None:
        raise SystemExit("ERROR: internal error: compression requested without a Ghostscript binary.")

    print(f"Compressing PDF ({COMPRESSION_PROFILE})...")
    compress_pdf(
        source_pdf_path,
        compressed_output_path,
        ghostscript_path=ghostscript_path,
        verbose=verbose,
    )

    if toc_spec is not None:
        # Add links after compression so they are not at the mercy of the lossy rewrite.
        WIKI_PDF.add_toc_links_and_outline(
            pdf_path=compressed_output_path,
            spec=toc_spec,
            playwright_python=playwright_python,
            verbose=verbose,
        )

    before_bytes = source_pdf_path.stat().st_size
    after_bytes = compressed_output_path.stat().st_size
    print(f"Compressed output: {compressed_output_path}")
    print(f"Compression result: {compression_summary(before_bytes, after_bytes)}")
    return ExportResult(output_path=output_path, compressed_output_path=compressed_output_path)


