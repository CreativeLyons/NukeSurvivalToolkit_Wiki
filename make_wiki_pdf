def find_playwright_python() -> str:
    candidates = [
        "/Library/Frameworks/Python.framework/Versions/3.10/bin/python3",
        shutil.which("python3") or "",
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            result = subprocess.run(
                [candidate, "-c", "import playwright"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if result.returncode == 0:
                return candidate
    raise SystemExit("ERROR: no Python with Playwright available.")


def load_base_config() -> dict:
    with MKDOCS_PDF_CONFIG.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle)


def load_full_nav() -> list:
    """Return the full MkDocs nav used as the source of truth for TOC grouping."""
    return load_base_config().get("nav", [])


def nav_entry_title(entry) -> str | None:
    """Return the display title for a single-entry MkDocs nav mapping."""
    if isinstance(entry, dict) and len(entry) == 1:
        return next(iter(entry))
    return None


def nav_entry_contains_category(entry, category: str) -> bool:
    """Check whether a nav entry contains docs from the requested category slug."""
    prefix = f"{category}/"

    if isinstance(entry, str):
        return entry.startswith(prefix) or entry == f"{category}/index.md"

    if isinstance(entry, list):
        return any(nav_entry_contains_category(child, category) for child in entry)

    if isinstance(entry, dict):
        return any(nav_entry_contains_category(value, category) for value in entry.values())

    return False


def nav_leaf_doc_paths(entry) -> list[Path]:
    """Flatten a nested MkDocs nav entry into markdown file paths."""
    if isinstance(entry, str):
        return [(DOC_ROOT / "docs" / entry).resolve()]

    if isinstance(entry, list):
        paths = []
        for child in entry:
            paths.extend(nav_leaf_doc_paths(child))
        return paths

    if isinstance(entry, dict):
        paths = []
        for value in entry.values():
            paths.extend(nav_leaf_doc_paths(value))
        return paths

    return []


def first_markdown_heading(doc_path: Path) -> str:
    """Read the first H1 from a markdown page for TOC and outline labels."""
    for line in doc_path.read_text(encoding="utf-8").splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    raise SystemExit(f"ERROR: no H1 heading found in {doc_path}")


def tool_groups_for_toc(*, category: str | None) -> list[tuple[str, list[str]]]:
    """Build grouped tool titles for the generated Tool Index."""
    groups: list[tuple[str, list[str]]] = []
    found_category = False

    for entry in load_full_nav():
        title = nav_entry_title(entry)
        if title is None or title in NON_TOOL_NAV_TITLES:
            continue
        if category and not nav_entry_contains_category(entry, category):
            continue

        docs = [
            path for path in nav_leaf_doc_paths(next(iter(entry.values())))
            if path.name != "index.md"
        ]
        if not docs:
            continue

        groups.append((title, [first_markdown_heading(path) for path in docs]))
        found_category = True

    if category and not found_category:
        raise SystemExit(
            f"ERROR: no nav category matched '{category}'. "
            "Use a docs directory slug such as draw, filter, transform, 3d, cg, curves, or utilities."
        )

    return groups


def write_target_config(target_dir: Path, *, version: str, nav: list[dict[str, str]]) -> Path:
    config = load_base_config()
    config["docs_dir"] = str((DOC_ROOT / "docs").resolve())
    config["site_dir"] = str((DOC_ROOT / "site").resolve())
    config["nav"] = nav
    config["hooks"] = [str((DOC_ROOT / "hooks" / "pdf_preprocess.py").resolve())]

    for plugin in config.get("plugins", []):
        if isinstance(plugin, dict) and "with-pdf" in plugin:
            pdf_config = plugin["with-pdf"]
            pdf_config["enabled_if_env"] = "ENABLE_PDF_EXPORT"
            pdf_config["cover_logo"] = str(COVER_IMAGE.resolve())
            pdf_config["cover_subtitle"] = f"Release {version}"
            pdf_config["custom_template_path"] = str((DOC_ROOT / "templates").resolve())
            pdf_config["output_path"] = "browser-render-placeholder.pdf"
            pdf_config["debug_html"] = True
            break

    config_path = target_dir / "mkdocs.target.yml"
    with config_path.open("w", encoding="utf-8") as handle:
        yaml.safe_dump(config, handle, sort_keys=False, allow_unicode=True)
    return config_path


def build_merged_html(target_dir: Path, *, version: str, nav: list[dict[str, str]], verbose: bool) -> Path:
    config_path = write_target_config(target_dir, version=version, nav=nav)
    html_path = target_dir / "merged-output.html"
    env = os.environ.copy()
    env["ENABLE_PDF_EXPORT"] = "1"
    env["DYLD_LIBRARY_PATH"] = "/opt/homebrew/lib"
    env["PKG_CONFIG_PATH"] = "/opt/homebrew/lib/pkgconfig"

    with html_path.open("w", encoding="utf-8") as handle:
        run(
            ["mkdocs", "build", "-f", str(config_path)],
            stdout=handle,
            stderr=None if verbose else subprocess.DEVNULL,
            env=env,
        )

    if not html_path.read_text(encoding="utf-8").lstrip().startswith("<html"):
        raise SystemExit(f"ERROR: merged HTML capture failed at {html_path}")

    run([sys.executable, str(DOC_ROOT / "scripts" / "prepare_browser_html.py"), "--html", str(html_path)])
    return html_path


def keep_articles(html_path: Path, *, keep_ids: set[str] | None = None, keep_urls: set[str] | None = None) -> None:
    keep_ids = keep_ids or set()
    keep_urls = keep_urls or set()

    soup = BeautifulSoup(html_path.read_text(encoding="utf-8"), "html.parser")
    body = soup.body
    if body is None:
        raise SystemExit(f"ERROR: no <body> found in merged HTML: {html_path}")

    articles = body.find_all("article", recursive=False)
    kept = []
    for article in articles:
        article_id = article.get("id", "")
        article_url = article.get("data-url", "")
        if article_id in keep_ids or article_url in keep_urls:
            kept.append(article.extract())
        else:
            article.decompose()

    if not kept:
        raise SystemExit("ERROR: HTML slice removed every article.")

    body.clear()
    for article in kept:
        body.append(article)

    html_path.write_text(str(soup), encoding="utf-8")


def render_html_to_pdf(
    html_path: Path,
    output_path: Path,
    *,
    css_path: Path,
    playwright_python: str,
    verbose: bool,
) -> None:
    run(
        [
            playwright_python,
            str(DOC_ROOT / "scripts" / "render_browser_pdf.py"),
            "--html",
            str(html_path),
            "--output",
            str(output_path),
            "--css",
            str(css_path),
        ],
        stdout=None if verbose else subprocess.DEVNULL,
        stderr=None if verbose else subprocess.DEVNULL,
    )


def render_standalone_html(
    html: str,
    *,
    temp_prefix: str,
    filename: str,
    output_path: Path,
    playwright_python: str,
    verbose: bool,
) -> Path:
    with tempfile.TemporaryDirectory(prefix=temp_prefix) as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        html_path = temp_dir / filename
        css_path = temp_dir / "empty.css"
        html_path.write_text(html, encoding="utf-8")
        css_path.write_text("/* no-op */\n", encoding="utf-8")
        render_html_to_pdf(
            html_path,
            output_path,
            css_path=css_path,
            playwright_python=playwright_python,
            verbose=verbose,
        )
    return output_path


def stamp_page_numbers(
    pdf_path: Path,
    *,
    first_page_index: int,
    start_number: int,
    last_page_index: int,
    playwright_python: str,
    verbose: bool,
) -> Path:
    if first_page_index > last_page_index:
        return pdf_path

    stamped_path = pdf_path.with_name(f"{pdf_path.stem}.stamped{pdf_path.suffix}")
    run(
        [
            playwright_python,
            str(STAMP_PAGE_NUMBERS_SCRIPT),
            "--input",
            str(pdf_path),
            "--output",
            str(stamped_path),
            "--first-page-index",
            str(first_page_index),
            "--last-page-index",
            str(last_page_index),
            "--start-number",
            str(start_number),
            "--font-name",
            STAMP_PAGE_NUMBER_FONT_NAME,
            "--font-size-pt",
            STAMP_PAGE_NUMBER_FONT_SIZE_PT,
            "--right-gap-pt",
            STAMP_PAGE_NUMBER_RIGHT_GAP_PT,
            "--bottom-gap-pt",
            STAMP_PAGE_NUMBER_BOTTOM_GAP_PT,
        ],
        stdout=None if verbose else subprocess.DEVNULL,
        stderr=None if verbose else subprocess.DEVNULL,
    )
    stamped_path.replace(pdf_path)
    return pdf_path


def page_count(pdf_path: Path) -> int:
    result = subprocess.run(
        ["pdfinfo", str(pdf_path)],
        check=True,
        capture_output=True,
        text=True,
    )
    for line in result.stdout.splitlines():
        if line.startswith("Pages:"):
            return int(line.split(":", 1)[1].strip())
    raise SystemExit(f"ERROR: could not determine page count for {pdf_path}")


def normalize_text(text: str) -> str:
    """Collapse extracted PDF text to a whitespace-normalized form."""
    return " ".join(text.split())


def pdf_pages_text(pdf_path: Path) -> list[str]:
    """Extract normalized text per page from a rendered PDF."""
    raw = subprocess.check_output(["pdftotext", str(pdf_path), "-"], stderr=subprocess.DEVNULL)
    return [normalize_text(page) for page in raw.decode("utf-8", errors="ignore").split("\f")]


def page_for_title(title: str, pages: list[str]) -> int:
    """Locate the first PDF page containing the requested title text."""
    needle = normalize_text(title)
    for index, page in enumerate(pages, start=1):
        if needle and needle in page:
            return index
    raise SystemExit(f"ERROR: could not locate '{title}' in rendered tool pages PDF.")


def build_tool_pages_pdf(
    *,
    category: str | None,
    version: str,
    output_path: Path,
    verbose: bool,
) -> Path:
    """Render the tool-pages PDF in reusable no-page-number mode."""
    cmd = [
        sys.executable,
        str(TOOL_PAGES_SCRIPT),
        "tool-pages",
        "--version",
        version,
        "--artifact-version",
        "1",
        "--output-dir",
        str(output_path.parent),
        "--no-page-numbers",
    ]
    if category:
        cmd.extend(["--category", category])
    if verbose:
        cmd.append("--verbose")

    run(cmd, stdout=None if verbose else subprocess.DEVNULL, stderr=None if verbose else subprocess.DEVNULL)

    built_path = output_path.parent / f"nst_wiki_tool_pages{'-' + category if category else ''}_v1.pdf"
    if built_path != output_path:
        shutil.copyfile(built_path, output_path)
    return output_path


def paginate_toc_entries(entries: list[tuple[str, int, int]]) -> list[list[dict]]:
    """Lay out Tool Index entries into stable PDF pages."""
    pages: list[list[dict]] = []
    current: list[dict] = []
    current_y = TOC_MARGIN_TOP_PT + TOC_TITLE_LINE_HEIGHT_PT + TOC_TITLE_MARGIN_BOTTOM_PT
    max_y = PDF_LETTER_HEIGHT_PT - TOC_MARGIN_BOTTOM_PT

    for label, page, level in entries:
        section_gap = TOC_LEVEL0_SECTION_GAP_PT if level == 0 and current else 0.0
        needed = section_gap + TOC_ROW_HEIGHT_PT
        if current_y + needed > max_y:
            pages.append(current)
            current = []
            current_y = TOC_MARGIN_TOP_PT
            section_gap = 0.0

        y_top = current_y + section_gap
        current.append(
            {
                "label": label,
                "page": page,
                "level": level,
                "section_break": bool(section_gap),
                "y_top_pt": y_top,
                "y_bottom_pt": y_top + TOC_ROW_HEIGHT_PT,
            }
        )
        current_y = y_top + TOC_ROW_HEIGHT_PT

    if current:
        pages.append(current)

    return pages


def toc_html(paginated_entries: list[list[dict]]) -> str:
    """Render the generated Tool Index as standalone printable HTML."""
    pages_html = []
    for page_index, page_entries in enumerate(paginated_entries):
        rows = []
        for entry in page_entries:
            classes = [f"level-{entry['level']}"]
            if entry["section_break"]:
                classes.append("section-break")
            rows.append(
                f'<div class="toc-entry {" ".join(classes)}">'
                f'<div class="toc-label">{entry["label"]}</div>'
                f'<div class="toc-page">{entry["page"]}</div>'
                "</div>"
            )

        heading = "<h1>Tool Index</h1>" if page_index == 0 else ""
        pages_html.append("<section class=\"toc-sheet\">" + heading + "\n".join(rows) + "</section>")

    body = "\n".join(pages_html)
    return f"""<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>NST Tool Index</title>
<style>
@page {{
  size: Letter;
  margin: {INTERIOR_PAGE_MARGIN};
}}

body {{
  margin: 0;
  padding: 0;
  background: #fff;
  color: {INTERIOR_TEXT_COLOR};
  font-family: {INTERIOR_FONT_FAMILY};
  font-size: {INTERIOR_BASE_FONT_SIZE};
  line-height: 1.34;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}}

h1 {{
  margin: {INTERIOR_H1_MARGIN};
  color: {INTERIOR_TEXT_COLOR};
  font-family: {INTERIOR_FONT_FAMILY};
  font-size: {INTERIOR_H1_SIZE};
  font-weight: 400;
  line-height: {TOC_TITLE_LINE_HEIGHT_PT}pt;
}}

.toc-sheet {{
  box-sizing: border-box;
  height: 251.4mm;
  padding: 0 62px;
  page-break-after: always;
}}

.toc-sheet:last-child {{
  page-break-after: auto;
}}

.toc-entry {{
  display: grid;
  grid-template-columns: 1fr {TOC_PAGE_NUMBER_COLUMN_WIDTH_PT}pt;
  column-gap: {TOC_COLUMN_GAP_PT}pt;
  margin: 0;
  height: {TOC_ROW_HEIGHT_PT}pt;
  line-height: {TOC_ROW_HEIGHT_PT}pt;
  break-inside: avoid;
  page-break-inside: avoid;
  white-space: nowrap;
}}

.toc-entry.level-0.section-break {{
  margin-top: {TOC_LEVEL0_SECTION_GAP_PT}pt;
}}

.toc-entry.level-1 {{
  padding-left: {TOC_LEVEL1_INDENT_PT}pt;
  font-size: 10.6pt;
}}

.toc-label {{
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}}

.toc-page {{
  text-align: right;
}}
</style>
</head>
<body>
  {body}
</body>
</html>
"""


