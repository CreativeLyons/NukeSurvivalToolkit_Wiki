# ---------------------------------------------------------------------------
# Renderer
# ---------------------------------------------------------------------------

def render_html_to_pdf(
    html_path: Path,
    output_path: Path,
    *,
    css_path: Path,
    playwright_python: str,
    verbose: bool,
) -> None:
    run(
        [
            playwright_python,
            str(DOC_ROOT / "scripts" / "render_browser_pdf.py"),
            "--html",
            str(html_path),
            "--output",
            str(output_path),
            "--css",
            str(css_path),
        ],
        stdout=None if verbose else subprocess.DEVNULL,
        stderr=None if verbose else subprocess.DEVNULL,
    )


# ---------------------------------------------------------------------------
# Section builders — all content comes from markdown via MkDocs merged HTML
# ---------------------------------------------------------------------------

def build_cover(*, version: str, output_path: Path, playwright_python: str, verbose: bool) -> Path:
    """Cover page — sourced from index.md via the mkdocs-with-pdf cover mechanism."""
    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-cover.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        html_path = build_merged_html(temp_dir, version=version, nav=[{"Home": "index.md"}], verbose=verbose)
        keep_articles(html_path, keep_ids={"doc-cover"})
        render_html_to_pdf(
            html_path,
            output_path,
            css_path=PDF_BROWSER_CSS,
            playwright_python=playwright_python,
            verbose=verbose,
        )
    return output_path


def build_section_from_markdown(
    *,
    nav: list[dict[str, str]],
    keep_urls: set[str],
    output_path: Path,
    version: str,
    playwright_python: str,
    verbose: bool,
    about_section: str | None = None,
) -> Path:
    """Build a PDF section from markdown-rendered MkDocs HTML.

    This is the core markdown-driven content builder.  The flow is:

      docs/*.md  →  MkDocs build  →  merged HTML  →  keep_articles()
                 →  (optional about split)  →  interior CSS  →  Playwright  →  PDF

    If the user edits a markdown file, re-running this function will
    automatically pick up those changes because MkDocs re-renders from
    the markdown source every time.

    Args:
        nav:             MkDocs nav entries for the pages to include.
        keep_urls:       data-url values to keep from the merged HTML.
        output_path:     Destination PDF path.
        version:         Release version string (for the MkDocs build config).
        playwright_python: Python interpreter with Playwright installed.
        verbose:         Show MkDocs / Playwright output.
        about_section:   If set, split the /about/ article to this section
                         ('special-thanks' or 'contact').
    """
    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-section.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)

        # 1. Build merged HTML from markdown via MkDocs.
        html_path = build_merged_html(temp_dir, version=version, nav=nav, verbose=verbose)

        # 2. Keep only the articles matching the target wiki pages.
        keep_articles(html_path, keep_urls=keep_urls)

        # 3. Split the /about/ article at a heading boundary if requested.
        if about_section:
            keep_about_section(html_path, about_section)

        # 4. Ensure relative asset paths resolve against the built site dir.
        add_base_tag(html_path)

        # 5. Write interior print CSS to a temp file for the renderer.
        css_path = temp_dir / "interior.css"
        css_path.write_text(generate_interior_css(), encoding="utf-8")

        # 6. Render to PDF via Playwright + Chrome.
        render_html_to_pdf(
            html_path,
            output_path,
            css_path=css_path,
            playwright_python=playwright_python,
            verbose=verbose,
        )
    return output_path


