def add_toc_links_and_outline(
    *,
    pdf_path: Path,
    spec: dict,
    playwright_python: str,
    verbose: bool,
) -> Path:
    """Inject clickable TOC links and bookmark outline data into the final PDF."""
    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-toc-links.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        spec_path = temp_dir / "toc-links.json"
        linked_output_path = temp_dir / "linked.pdf"
        spec_path.write_text(json.dumps(spec, indent=2), encoding="utf-8")
        run(
            [
                playwright_python,
                str(ADD_PDF_TOC_LINKS_SCRIPT),
                "--input",
                str(pdf_path),
                "--output",
                str(linked_output_path),
                "--spec",
                str(spec_path),
            ],
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None if verbose else subprocess.DEVNULL,
        )
        shutil.move(str(linked_output_path), str(pdf_path))
    return pdf_path


def render_stable_toc_pdf(
    *,
    front_pages: int,
    front_entries: list[tuple[str, int, int]],
    tool_groups: list[tuple[str, list[str]]],
    tool_relative_page_map: dict[str, int],
    output_path: Path,
    playwright_python: str,
    verbose: bool,
) -> tuple[Path, int, list[list[dict]], list[tuple[str, int, int]]]:
    """Render the Tool Index repeatedly until its own page count stabilizes."""
    estimated_toc_pages = 1

    for _ in range(4):
        tool_page_offset = front_pages + estimated_toc_pages
        entries = list(front_entries)
        for category_title, tool_titles in tool_groups:
            first_tool_title = tool_titles[0]
            entries.append((category_title, tool_page_offset + tool_relative_page_map[first_tool_title], 0))
            for tool_title in tool_titles:
                entries.append((tool_title, tool_page_offset + tool_relative_page_map[tool_title], 1))

        paginated_entries = paginate_toc_entries(entries)
        render_standalone_html(
            toc_html(paginated_entries),
            temp_prefix="nst-make-wiki-toc.",
            filename="toc.html",
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=verbose,
        )
        toc_pages = page_count(output_path)
        if toc_pages == len(paginated_entries) == estimated_toc_pages:
            return output_path, toc_pages, paginated_entries, entries
        estimated_toc_pages = toc_pages

    raise SystemExit("ERROR: TOC page count did not stabilize after repeated renders.")


def toc_link_rect(entry: dict) -> list[float]:
    """Convert a Tool Index row into a PDF link rectangle."""
    indent = TOC_LEVEL1_INDENT_PT if entry["level"] == 1 else 0.0
    x1 = TOC_CONTENT_LEFT_PT + indent
    x2 = TOC_CONTENT_RIGHT_PT
    y1 = PDF_LETTER_HEIGHT_PT - entry["y_bottom_pt"] - TOC_LINK_PAD_Y_PT
    y2 = PDF_LETTER_HEIGHT_PT - entry["y_top_pt"] + TOC_LINK_PAD_Y_PT
    return [round(x1, 3), round(y1, 3), round(x2, 3), round(y2, 3)]


def build_toc_link_spec(
    *,
    toc_start_page_number: int,
    paginated_entries: list[list[dict]],
    flat_entries: list[tuple[str, int, int]],
) -> dict:
    """Build the PDF link and outline spec for the generated Tool Index."""
    links = []
    outline = []

    for toc_page_offset, page_entries in enumerate(paginated_entries):
        source_page_number = toc_start_page_number + toc_page_offset
        for entry in page_entries:
            links.append(
                {
                    "source_page_number": source_page_number,
                    "dest_page_number": entry["page"],
                    "rect": toc_link_rect(entry),
                }
            )

    for label, page_number, level in flat_entries:
        outline.append(
            {
                "title": label,
                "page_number": page_number,
                "level": level,
            }
        )

    return {"links": links, "outline": outline}


def extract_pdf_pages(
    source_pdf: Path,
    output_path: Path,
    *,
    start_page: int,
    end_page: int,
    verbose: bool,
) -> Path:
    if start_page > end_page:
        raise SystemExit(f"ERROR: invalid extraction range {start_page}-{end_page} for {source_pdf}")

    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-extract.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        page_pattern = temp_dir / "page-%03d.pdf"
        run(
            [
                "pdfseparate",
                "-f",
                str(start_page),
                "-l",
                str(end_page),
                str(source_pdf),
                str(page_pattern),
            ],
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None if verbose else subprocess.DEVNULL,
        )

        extracted_pages = sorted(temp_dir.glob("page-*.pdf"))
        if not extracted_pages:
            raise SystemExit(f"ERROR: pdfseparate did not extract any pages from {source_pdf}")

        if len(extracted_pages) == 1:
            shutil.copyfile(extracted_pages[0], output_path)
            return output_path

        run(
            ["pdfunite", *[str(path) for path in extracted_pages], str(output_path)],
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None if verbose else subprocess.DEVNULL,
        )
    return output_path


def merge_pdf_sequence(
