def contact_html(*, page_number: int) -> str:
    article = markdown_article(CONTACT_DOC)
    title = article.find("h1", recursive=False)
    paragraphs = article.find_all("p", recursive=False)
    if title is None or not paragraphs:
        raise SystemExit("ERROR: contact markdown is missing required structure.")

    soup = template_soup(CONTACT_TEMPLATE)
    body = soup.body
    if body is None:
        raise SystemExit("ERROR: contact template has no <body>.")
    body.clear()

    title_clone = clone_tag(title)
    strip_ids(title_clone)
    body.append(title_clone)

    for paragraph in paragraphs:
        paragraph_clone = clone_tag(paragraph)
        strip_ids(paragraph_clone)
        body.append(paragraph_clone)

    page_number_node = soup.new_tag("div", **{"class": "page-number"})
    page_number_node.string = str(page_number)
    body.append(page_number_node)
    inject_margin_box_page_numbers(soup, page_numbers=(page_number,))
    return str(soup)


