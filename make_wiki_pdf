def main() -> int:
    args = parse_args()
    target = args.target
    output_dir = Path(args.output_dir).resolve()
    output_dir.mkdir(parents=True, exist_ok=True)

    if target in PLANNED_TARGETS:
        print(f"Target '{target}' is planned but not implemented yet.")
        print(
            "Implemented targets: cover, page2, technical-details, contact, special-thanks, "
            "pages-1-2, pages-1-5, full-so-far, menu"
        )
        return 2

    if target not in {"cover", "page2", "technical-details", "contact", "special-thanks", "pages-1-2", "pages-1-5", "full-so-far", "menu"}:
        print(f"Unknown target: {target}", file=sys.stderr)
        print(
            "Implemented targets: cover, page2, technical-details, contact, special-thanks, "
            "pages-1-2, pages-1-5, full-so-far, menu",
            file=sys.stderr,
        )
        return 2

    playwright_python = find_playwright_python()
    output_path = output_path_for(target, output_dir, artifact_version=args.artifact_version)

    if target == "cover":
        build_cover(
            version=args.version,
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "page2":
        build_page2(output_path=output_path, playwright_python=playwright_python, verbose=args.verbose)
    elif target == "technical-details":
        build_technical_details(
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "contact":
        build_contact(
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "special-thanks":
        build_special_thanks(
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "menu":
        build_menu(output_path=output_path, playwright_python=playwright_python, verbose=args.verbose)
    elif target == "pages-1-2":
        build_pages_1_2(
            version=args.version,
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "pages-1-5":
        build_pages_1_5(
            version=args.version,
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    else:
        build_full_so_far(
            version=args.version,
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )

    print(output_path)
    if args.open:
        open_pdf(output_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
