def technical_nested_item(soup: BeautifulSoup, nested_li: Tag, nested_index: int, *, style: str) -> Tag:
    wrapper = soup.new_tag("div", **{"class": "subitem" if style == "alpha" else "numeric-subitem"})
    marker = soup.new_tag("div", **{"class": "submarker"})
    marker.string = f"{chr(ord('a') + nested_index - 1)}.)" if style == "alpha" else f"{nested_index}.)"
    content = soup.new_tag("div", **{"class": "subcontent"})
    wrapper.append(marker)
    wrapper.append(content)

    has_block_children = any(
        isinstance(child, Tag) and child.name in {"p", "ol", "ul"}
        for child in nested_li.children
    )
    if not has_block_children:
        paragraph = soup.new_tag("p")
        append_html_fragment(paragraph, nested_li.decode_contents())
        convert_code_to_mono(paragraph)
        content.append(paragraph)
        return wrapper

    for child in [node for node in nested_li.children if isinstance(node, Tag)]:
        if child.name == "p":
            paragraph = clone_tag(child)
            strip_ids(paragraph)
            convert_code_to_mono(paragraph)
            content.append(paragraph)
        elif child.name in {"ol", "ul"}:
            paragraph = soup.new_tag("p")
            paragraph.string = child.get_text(" ", strip=True)
            content.append(paragraph)
        else:
            block = clone_tag(child)
            strip_ids(block)
            convert_code_to_mono(block)
            content.append(block)
    return wrapper


def technical_item(soup: BeautifulSoup, li: Tag, item_number: int) -> Tag:
    item = soup.new_tag("div", **{"class": "item"})
    marker = soup.new_tag("div", **{"class": "marker"})
    marker.string = f"{item_number}.)"
    content = soup.new_tag("div", **{"class": "content"})
    item.append(marker)
    item.append(content)

    for child in [node for node in li.children if isinstance(node, Tag)]:
        if child.name == "p":
            paragraph = clone_tag(child)
            strip_ids(paragraph)
            convert_code_to_mono(paragraph)
            content.append(paragraph)
        elif child.name == "ol":
            nested_style = "alpha" if item_number in {1, 4} else "numeric"
            nested_items = child.find_all("li", recursive=False)
            trailing_paragraph: Tag | None = None
            if item_number == 4 and nested_items:
                last_nested = nested_items[-1]
                direct_paragraphs = last_nested.find_all("p", recursive=False)
                if len(direct_paragraphs) > 1:
                    trailing_paragraph = clone_tag(direct_paragraphs[-1])
                    strip_ids(trailing_paragraph)
                    convert_code_to_mono(trailing_paragraph)
                    trailing_paragraph["class"] = ["tight"]
                    direct_paragraphs[-1].extract()

            for nested_index, nested_li in enumerate(nested_items, 1):
                content.append(technical_nested_item(soup, nested_li, nested_index, style=nested_style))

            if item_number == 1:
                last_paragraph = next(
                    (node for node in reversed(content.find_all("p", recursive=False))),
                    None,
                )
                if last_paragraph is not None:
                    last_paragraph["class"] = ["callout"]
            if trailing_paragraph is not None:
                content.append(trailing_paragraph)
        else:
            block = clone_tag(child)
            strip_ids(block)
            convert_code_to_mono(block)
            content.append(block)

    return item


def technical_details_html() -> str:
    article = markdown_article(TECHNICAL_DETAILS_DOC)
    title = article.find("h1", recursive=False)
    intro = article.find("p", recursive=False)
    top_list = article.find("ol", recursive=False)
    if title is None or intro is None or top_list is None:
        raise SystemExit("ERROR: technical details markdown is missing required structure.")

    items = top_list.find_all("li", recursive=False)
    if not items:
        raise SystemExit("ERROR: technical details ordered list contains no items.")

    soup = template_soup(
        TECHNICAL_DETAILS_TEMPLATE,
        replacements={"__JETBRAINS_MONO_REGULAR_URI__": JETBRAINS_MONO_REGULAR.resolve().as_uri()},
    )
    body = soup.body
    if body is None:
        raise SystemExit("ERROR: technical details template has no <body>.")
    body.clear()

    flow_style = soup.new_tag("style")
    flow_style.string = f"""
.spacer-page {{
  break-after: page;
  page-break-after: always;
  visibility: hidden;
  height: 1px;
}}

.flow-main {{
  padding: 10px 54px 0 54px;
}}

.flow-main .item,
.flow-main .subitem,
.flow-main .numeric-subitem {{
  break-inside: avoid;
  page-break-inside: avoid;
}}
"""
    body.append(flow_style)

    for _ in range(TECHNICAL_DETAILS_CONTEXT_PAGES):
        spacer = soup.new_tag("div", **{"class": "spacer-page"})
        spacer.string = "."
        body.append(spacer)

    flow_main = soup.new_tag("main", **{"class": "flow-main"})

    title_clone = clone_tag(title)
    strip_ids(title_clone)
    flow_main.append(title_clone)

    intro_clone = clone_tag(intro)
    strip_ids(intro_clone)
    flow_main.append(intro_clone)

    for item_number, item_li in enumerate(items, 1):
        flow_main.append(technical_item(soup, item_li, item_number))

    body.append(flow_main)

    return str(soup)


