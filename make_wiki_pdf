def build_full_wiki(
    *,
    version: str,
    output_path: Path,
    playwright_python: str,
    verbose: bool,
    category: str | None = None,
) -> Path:
    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-full-wiki.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        front_main_pdf = temp_dir / "front-main.pdf"
        toc_pdf = temp_dir / "toc.pdf"
        tool_pages_pdf = temp_dir / "tool-pages.pdf"
        back_main_pdf = temp_dir / "back-main.pdf"
        cover_pdf = temp_dir / "cover.pdf"
        about_installation_pdf = temp_dir / "about-installation.pdf"
        technical_details_pdf = temp_dir / "technical-details.pdf"
        menu_pdf = temp_dir / "menu.pdf"
        special_thanks_pdf = temp_dir / "special-thanks.pdf"
        contact_pdf = temp_dir / "contact.pdf"

        build_cover(
            version=version,
            output_path=cover_pdf,
            playwright_python=playwright_python,
            verbose=verbose,
            stamp_numbers=False,
        )
        build_about_installation(
            output_path=about_installation_pdf,
            playwright_python=playwright_python,
            verbose=verbose,
            stamp_numbers=False,
        )
        build_technical_details(
            output_path=technical_details_pdf,
            playwright_python=playwright_python,
            verbose=verbose,
            stamp_numbers=False,
        )
        build_menu(
            output_path=menu_pdf,
            playwright_python=playwright_python,
            verbose=verbose,
            page_number=0,
            stamp_numbers=False,
        )
        merge_pdf_sequence(
            [cover_pdf, about_installation_pdf, technical_details_pdf, menu_pdf],
            front_main_pdf,
            verbose=verbose,
        )

        print("Rendering tool pages without visible numbering…")
        build_tool_pages_pdf(
            category=category,
            version=version,
            output_path=tool_pages_pdf,
            verbose=verbose,
        )

        tool_pages = pdf_pages_text(tool_pages_pdf)
        tool_groups = tool_groups_for_toc(category=category)
        tool_relative_page_map = {}
        for _group_title, tool_titles in tool_groups:
            for tool_title in tool_titles:
                tool_relative_page_map[tool_title] = page_for_title(tool_title, tool_pages)

        front_pages = page_count(front_main_pdf)
        print("Rendering TOC pages…")
        _, toc_pages, paginated_toc_entries, flat_toc_entries = render_stable_toc_pdf(
            front_pages=front_pages,
            front_entries=front_matter_toc_entries(menu_page_number=front_pages),
            tool_groups=tool_groups,
            tool_relative_page_map=tool_relative_page_map,
            output_path=toc_pdf,
            playwright_python=playwright_python,
            verbose=verbose,
        )

        build_special_thanks(
            output_path=special_thanks_pdf,
            playwright_python=playwright_python,
            verbose=verbose,
            page_numbers=(0, 0),
            stamp_numbers=False,
        )
        build_contact(
            output_path=contact_pdf,
            playwright_python=playwright_python,
            verbose=verbose,
            page_number=0,
            stamp_numbers=False,
        )
        merge_pdf_sequence(
            [special_thanks_pdf, contact_pdf],
            back_main_pdf,
            verbose=verbose,
        )

        merge_pdf_sequence(
            [front_main_pdf, toc_pdf, tool_pages_pdf, back_main_pdf],
            output_path,
            verbose=verbose,
        )

    total_pages = page_count(output_path)
    stamp_page_numbers(
        output_path,
        first_page_index=1,
        last_page_index=total_pages,
        start_number=1,
        playwright_python=playwright_python,
        verbose=verbose,
    )
    return add_toc_links_and_outline(
        pdf_path=output_path,
        spec=build_toc_link_spec(
            toc_start_page_number=front_pages + 1,
            paginated_entries=paginated_toc_entries,
            flat_entries=flat_toc_entries,
        ),
        playwright_python=playwright_python,
        verbose=verbose,
    )


def output_path_for(target: str, output_dir: Path, *, artifact_version: int, category: str | None = None) -> Path:
    filename = {
        "cover": f"nst_wiki_cover_v{artifact_version}.pdf",
        ABOUT_INSTALLATION_TARGET: f"nst_wiki_about_installation_v{artifact_version}.pdf",
        "technical-details": f"nst_wiki_technical_details_v{artifact_version}.pdf",
        "contact": f"nst_wiki_contact_v{artifact_version}.pdf",
        "special-thanks": f"nst_wiki_special_thanks_v{artifact_version}.pdf",
        "pages-1-2": f"nst_wiki_v{artifact_version}.pdf",
        "pages-1-5": f"nst_wiki_v{artifact_version}.pdf",
        "full-so-far": f"nst_wiki_v{artifact_version}.pdf",
        "full-wiki": (
            f"nst_wiki_full_with_tools-{category}_v{artifact_version}.pdf"
            if category else f"nst_wiki_full_with_tools_v{artifact_version}.pdf"
        ),
        "menu": f"nst_wiki_v{artifact_version}-menu.pdf",
    }[target]
    return output_dir / filename


def open_pdf(path: Path) -> None:
    run(["open", str(path)])


def main() -> int:
    args = parse_args()
    target = normalize_target(args.target)
    output_dir = Path(args.output_dir).resolve()
    output_dir.mkdir(parents=True, exist_ok=True)

    if target in PLANNED_TARGETS:
        print(f"Target '{target}' is planned but not implemented yet.")
        print(
            "Implemented targets: cover, about-installation, technical-details, contact, special-thanks, "
            "pages-1-2, pages-1-5, full-so-far, full-wiki, menu"
        )
        return 2

    if target not in {"cover", ABOUT_INSTALLATION_TARGET, "technical-details", "contact", "special-thanks", "pages-1-2", "pages-1-5", "full-so-far", "full-wiki", "menu"}:
        print(f"Unknown target: {target}", file=sys.stderr)
        print(
            "Implemented targets: cover, about-installation, technical-details, contact, special-thanks, "
            "pages-1-2, pages-1-5, full-so-far, full-wiki, menu",
            file=sys.stderr,
        )
        return 2

    playwright_python = find_playwright_python()
    output_path = output_path_for(
        target,
        output_dir,
        artifact_version=args.artifact_version,
        category=args.category if target == "full-wiki" else None,
    )

    if target == "cover":
        build_cover(
            version=args.version,
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == ABOUT_INSTALLATION_TARGET:
        build_about_installation(output_path=output_path, playwright_python=playwright_python, verbose=args.verbose)
    elif target == "technical-details":
        build_technical_details(
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "contact":
        build_contact(
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "special-thanks":
        build_special_thanks(
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "menu":
        build_menu(output_path=output_path, playwright_python=playwright_python, verbose=args.verbose)
    elif target == "pages-1-2":
        build_pages_1_2(
            version=args.version,
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "pages-1-5":
        build_pages_1_5(
            version=args.version,
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )
    elif target == "full-wiki":
        build_full_wiki(
            version=args.version,
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
            category=args.category,
        )
    else:
        build_full_so_far(
            version=args.version,
            output_path=output_path,
            playwright_python=playwright_python,
            verbose=args.verbose,
        )

    print(output_path)
    if args.open:
        open_pdf(output_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
