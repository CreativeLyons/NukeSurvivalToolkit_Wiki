            "contact, special-thanks, pages-1-2, pages-1-5, full-so-far, menu."
        )
    )
    parser.add_argument(
        "target",
        help=(
            "Target to build. Implemented now: cover, page2, "
            "technical-details, contact, special-thanks, pages-1-2, "
            "pages-1-5, full-so-far, menu. "
            "Planned later: main-sections, tool-pages, full-wiki."
        ),
    )
    parser.add_argument("--version", default=DEFAULT_VERSION, help="Release string for the cover subtitle.")
