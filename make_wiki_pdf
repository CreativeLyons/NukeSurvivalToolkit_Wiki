# ---------------------------------------------------------------------------
# Version source-of-truth: derived from mkdocs.pdf.yml, not hard-coded.
# ---------------------------------------------------------------------------

def get_version_from_config() -> str:
    """Read the release version from the mkdocs.pdf.yml cover_subtitle field."""
    try:
        with MKDOCS_PDF_CONFIG.open("r", encoding="utf-8") as handle:
            config = yaml.safe_load(handle)
        for plugin in config.get("plugins", []):
            if isinstance(plugin, dict) and "with-pdf" in plugin:
                subtitle = plugin["with-pdf"].get("cover_subtitle", "")
                match = re.search(r"v[\d.]+", subtitle)
                if match:
                    return match.group(0)
    except Exception:
        pass
    return "v2.2.0"


DEFAULT_VERSION = get_version_from_config()


