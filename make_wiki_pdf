# ---------------------------------------------------------------------------
# Composite builders (combine multiple section PDFs via pdfunite)
# ---------------------------------------------------------------------------

def build_pages_1_2(*, version: str, output_path: Path, playwright_python: str, verbose: bool) -> Path:
    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-pages12.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        cover_pdf = temp_dir / "cover.pdf"
        page2_pdf = temp_dir / "page2.pdf"
        build_cover(version=version, output_path=cover_pdf, playwright_python=playwright_python, verbose=verbose)
        build_page2(version=version, output_path=page2_pdf, playwright_python=playwright_python, verbose=verbose)
        run(
            ["pdfunite", str(cover_pdf), str(page2_pdf), str(output_path)],
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None if verbose else subprocess.DEVNULL,
        )
    return output_path


def build_pages_1_5(*, version: str, output_path: Path, playwright_python: str, verbose: bool) -> Path:
    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-pages15.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        cover_pdf = temp_dir / "cover.pdf"
        page2_pdf = temp_dir / "page2.pdf"
        tech_pdf = temp_dir / "technical-details.pdf"
        build_cover(version=version, output_path=cover_pdf, playwright_python=playwright_python, verbose=verbose)
        build_page2(version=version, output_path=page2_pdf, playwright_python=playwright_python, verbose=verbose)
        build_technical_details(version=version, output_path=tech_pdf, playwright_python=playwright_python, verbose=verbose)
        run(
            ["pdfunite", str(cover_pdf), str(page2_pdf), str(tech_pdf), str(output_path)],
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None if verbose else subprocess.DEVNULL,
        )
    return output_path


def build_full_so_far(*, version: str, output_path: Path, playwright_python: str, verbose: bool) -> Path:
    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-full-so-far.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        cover_pdf = temp_dir / "cover.pdf"
        page2_pdf = temp_dir / "page2.pdf"
        tech_pdf = temp_dir / "technical-details.pdf"
        menu_pdf = temp_dir / "menu.pdf"
        thanks_pdf = temp_dir / "special-thanks.pdf"
        contact_pdf = temp_dir / "contact.pdf"
        build_cover(version=version, output_path=cover_pdf, playwright_python=playwright_python, verbose=verbose)
        build_page2(version=version, output_path=page2_pdf, playwright_python=playwright_python, verbose=verbose)
        build_technical_details(version=version, output_path=tech_pdf, playwright_python=playwright_python, verbose=verbose)
        build_menu(version=version, output_path=menu_pdf, playwright_python=playwright_python, verbose=verbose)
        build_special_thanks(version=version, output_path=thanks_pdf, playwright_python=playwright_python, verbose=verbose)
        build_contact(version=version, output_path=contact_pdf, playwright_python=playwright_python, verbose=verbose)
        run(
            [
                "pdfunite",
                str(cover_pdf),
                str(page2_pdf),
                str(tech_pdf),
                str(menu_pdf),
                str(thanks_pdf),
                str(contact_pdf),
                str(output_path),
            ],
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None if verbose else subprocess.DEVNULL,
        )
    return output_path


