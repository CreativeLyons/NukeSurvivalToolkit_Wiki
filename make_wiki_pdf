def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Build approved NST wiki PDF slices as local review artifacts. "
            "Currently implemented: cover, about-installation, technical-details, "
            "contact, special-thanks, pages-1-2, pages-1-5, full-so-far, full-wiki, menu."
        )
    )
    parser.add_argument(
        "target",
        help=(
            "Target to build. Implemented now: cover, about-installation, "
            "technical-details, contact, special-thanks, pages-1-2, "
            "pages-1-5, full-so-far, full-wiki, menu. Legacy alias still accepted: page2. "
            "Planned later: main-sections, tool-pages."
        ),
    )
    parser.add_argument("--version", default=DEFAULT_VERSION, help="Release string for the cover subtitle.")
    parser.add_argument(
        "--artifact-version",
        type=int,
        default=1,
        help="Version number embedded in the local review PDF filename.",
    )
    parser.add_argument(
        "--output-dir",
        default=str(DEFAULT_OUTPUT_DIR),
        help="Directory for local output PDFs. Defaults to /tmp/nst-wiki-pdf.",
    )
    parser.add_argument(
        "--open",
        action="store_true",
        help="Open the output PDF after building.",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Show underlying MkDocs and renderer command output.",
    )
    return parser.parse_args()


def run(cmd: list[str], *, stdout=None, stderr=None, env: dict[str, str] | None = None) -> None:
    subprocess.run(cmd, check=True, stdout=stdout, stderr=stderr, env=env)


def apply_interior_template_tokens(html: str) -> str:
    replacements = {
        "__INTERIOR_PAGE_MARGIN__": INTERIOR_PAGE_MARGIN,
        "__INTERIOR_TEXT_SIDE_PADDING__": INTERIOR_TEXT_SIDE_PADDING,
        "__INTERIOR_FONT_FAMILY__": INTERIOR_FONT_FAMILY,
        "__INTERIOR_TEXT_COLOR__": INTERIOR_TEXT_COLOR,
        "__INTERIOR_LINK_COLOR__": INTERIOR_LINK_COLOR,
        "__INTERIOR_LINK_DECORATION__": INTERIOR_LINK_DECORATION,
        "__INTERIOR_BASE_FONT_SIZE__": INTERIOR_BASE_FONT_SIZE,
        "__INTERIOR_BASE_LINE_HEIGHT__": INTERIOR_BASE_LINE_HEIGHT,
        "__INTERIOR_H1_MARGIN__": INTERIOR_H1_MARGIN,
        "__INTERIOR_H1_SIZE__": INTERIOR_H1_SIZE,
        "__INTERIOR_PARAGRAPH_MARGIN__": INTERIOR_PARAGRAPH_MARGIN,
        "__INTERIOR_PAGE_NUMBER_RIGHT__": INTERIOR_PAGE_NUMBER_RIGHT,
        "__INTERIOR_PAGE_NUMBER_BOTTOM__": INTERIOR_PAGE_NUMBER_BOTTOM,
        "__INTERIOR_PAGE_NUMBER_TRANSFORM__": INTERIOR_PAGE_NUMBER_TRANSFORM,
        "__INTERIOR_PAGE_NUMBER_COLOR__": INTERIOR_PAGE_NUMBER_COLOR,
        "__INTERIOR_PAGE_NUMBER_FONT_FAMILY__": INTERIOR_PAGE_NUMBER_FONT_FAMILY,
        "__INTERIOR_PAGE_NUMBER_FONT_SIZE__": INTERIOR_PAGE_NUMBER_FONT_SIZE,
    }
    for placeholder, value in replacements.items():
        html = html.replace(placeholder, value)
    return html


def find_playwright_python() -> str:
    candidates = [
        "/Library/Frameworks/Python.framework/Versions/3.10/bin/python3",
        shutil.which("python3") or "",
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            result = subprocess.run(
                [candidate, "-c", "import playwright"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if result.returncode == 0:
                return candidate
    raise SystemExit("ERROR: no Python with Playwright available.")


def load_base_config() -> dict:
    with MKDOCS_PDF_CONFIG.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle)


def write_target_config(target_dir: Path, *, version: str, nav: list[dict[str, str]]) -> Path:
    config = load_base_config()
    config["docs_dir"] = str((DOC_ROOT / "docs").resolve())
    config["site_dir"] = str((DOC_ROOT / "site").resolve())
    config["nav"] = nav
    config["hooks"] = [str((DOC_ROOT / "hooks" / "pdf_preprocess.py").resolve())]

    for plugin in config.get("plugins", []):
        if isinstance(plugin, dict) and "with-pdf" in plugin:
            pdf_config = plugin["with-pdf"]
            pdf_config["enabled_if_env"] = "ENABLE_PDF_EXPORT"
            pdf_config["cover_logo"] = str(COVER_IMAGE.resolve())
            pdf_config["cover_subtitle"] = f"Release {version}"
            pdf_config["custom_template_path"] = str((DOC_ROOT / "templates").resolve())
            pdf_config["output_path"] = "browser-render-placeholder.pdf"
            pdf_config["debug_html"] = True
            break

    config_path = target_dir / "mkdocs.target.yml"
    with config_path.open("w", encoding="utf-8") as handle:
        yaml.safe_dump(config, handle, sort_keys=False, allow_unicode=True)
    return config_path


def build_merged_html(target_dir: Path, *, version: str, nav: list[dict[str, str]], verbose: bool) -> Path:
    config_path = write_target_config(target_dir, version=version, nav=nav)
    html_path = target_dir / "merged-output.html"
    env = os.environ.copy()
    env["ENABLE_PDF_EXPORT"] = "1"
    env["DYLD_LIBRARY_PATH"] = "/opt/homebrew/lib"
    env["PKG_CONFIG_PATH"] = "/opt/homebrew/lib/pkgconfig"

    with html_path.open("w", encoding="utf-8") as handle:
        run(
            ["mkdocs", "build", "-f", str(config_path)],
            stdout=handle,
            stderr=None if verbose else subprocess.DEVNULL,
            env=env,
        )

    if not html_path.read_text(encoding="utf-8").lstrip().startswith("<html"):
        raise SystemExit(f"ERROR: merged HTML capture failed at {html_path}")

    run([sys.executable, str(DOC_ROOT / "scripts" / "prepare_browser_html.py"), "--html", str(html_path)])
    return html_path


def keep_articles(html_path: Path, *, keep_ids: set[str] | None = None, keep_urls: set[str] | None = None) -> None:
    keep_ids = keep_ids or set()
    keep_urls = keep_urls or set()

    soup = BeautifulSoup(html_path.read_text(encoding="utf-8"), "html.parser")
    body = soup.body
    if body is None:
        raise SystemExit(f"ERROR: no <body> found in merged HTML: {html_path}")

    articles = body.find_all("article", recursive=False)
    kept = []
    for article in articles:
        article_id = article.get("id", "")
        article_url = article.get("data-url", "")
        if article_id in keep_ids or article_url in keep_urls:
            kept.append(article.extract())
        else:
            article.decompose()

    if not kept:
        raise SystemExit("ERROR: HTML slice removed every article.")

    body.clear()
    for article in kept:
        body.append(article)

    html_path.write_text(str(soup), encoding="utf-8")


def render_html_to_pdf(
    html_path: Path,
    output_path: Path,
    *,
    css_path: Path,
    playwright_python: str,
    verbose: bool,
) -> None:
    run(
        [
            playwright_python,
            str(DOC_ROOT / "scripts" / "render_browser_pdf.py"),
            "--html",
            str(html_path),
            "--output",
            str(output_path),
            "--css",
            str(css_path),
        ],
        stdout=None if verbose else subprocess.DEVNULL,
        stderr=None if verbose else subprocess.DEVNULL,
    )


def render_standalone_html(
    html: str,
    *,
    temp_prefix: str,
    filename: str,
    output_path: Path,
    playwright_python: str,
    verbose: bool,
) -> Path:
    with tempfile.TemporaryDirectory(prefix=temp_prefix) as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        html_path = temp_dir / filename
        css_path = temp_dir / "empty.css"
        html_path.write_text(html, encoding="utf-8")
        css_path.write_text("/* no-op */\n", encoding="utf-8")
        render_html_to_pdf(
            html_path,
            output_path,
            css_path=css_path,
            playwright_python=playwright_python,
            verbose=verbose,
        )
    return output_path


def stamp_page_numbers(
    pdf_path: Path,
    *,
    first_page_index: int,
    start_number: int,
    last_page_index: int,
    playwright_python: str,
    verbose: bool,
) -> Path:
    if first_page_index > last_page_index:
        return pdf_path

    stamped_path = pdf_path.with_name(f"{pdf_path.stem}.stamped{pdf_path.suffix}")
    run(
        [
            playwright_python,
            str(STAMP_PAGE_NUMBERS_SCRIPT),
            "--input",
            str(pdf_path),
            "--output",
            str(stamped_path),
            "--first-page-index",
            str(first_page_index),
            "--last-page-index",
            str(last_page_index),
            "--start-number",
            str(start_number),
            "--font-name",
            STAMP_PAGE_NUMBER_FONT_NAME,
            "--font-size-pt",
            STAMP_PAGE_NUMBER_FONT_SIZE_PT,
            "--right-gap-pt",
            STAMP_PAGE_NUMBER_RIGHT_GAP_PT,
            "--bottom-gap-pt",
            STAMP_PAGE_NUMBER_BOTTOM_GAP_PT,
        ],
        stdout=None if verbose else subprocess.DEVNULL,
        stderr=None if verbose else subprocess.DEVNULL,
    )
    stamped_path.replace(pdf_path)
    return pdf_path


def page_count(pdf_path: Path) -> int:
    result = subprocess.run(
        ["pdfinfo", str(pdf_path)],
        check=True,
        capture_output=True,
        text=True,
    )
    for line in result.stdout.splitlines():
        if line.startswith("Pages:"):
            return int(line.split(":", 1)[1].strip())
    raise SystemExit(f"ERROR: could not determine page count for {pdf_path}")


def extract_pdf_pages(
    source_pdf: Path,
    output_path: Path,
    *,
    start_page: int,
    end_page: int,
    verbose: bool,
) -> Path:
    if start_page > end_page:
        raise SystemExit(f"ERROR: invalid extraction range {start_page}-{end_page} for {source_pdf}")

    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-extract.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        page_pattern = temp_dir / "page-%03d.pdf"
        run(
            [
                "pdfseparate",
                "-f",
                str(start_page),
                "-l",
                str(end_page),
                str(source_pdf),
                str(page_pattern),
            ],
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None if verbose else subprocess.DEVNULL,
        )

        extracted_pages = sorted(temp_dir.glob("page-*.pdf"))
        if not extracted_pages:
            raise SystemExit(f"ERROR: pdfseparate did not extract any pages from {source_pdf}")

        if len(extracted_pages) == 1:
            shutil.copyfile(extracted_pages[0], output_path)
            return output_path

        run(
            ["pdfunite", *[str(path) for path in extracted_pages], str(output_path)],
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None if verbose else subprocess.DEVNULL,
        )
    return output_path


def merge_pdf_sequence(
    pdf_paths: list[Path],
    output_path: Path,
    *,
    verbose: bool,
) -> Path:
    if not pdf_paths:
        raise SystemExit("ERROR: no PDFs provided for merge.")
    run(
        ["pdfunite", *[str(path) for path in pdf_paths], str(output_path)],
        stdout=None if verbose else subprocess.DEVNULL,
        stderr=None if verbose else subprocess.DEVNULL,
    )
    return output_path


def normalize_target(raw_target: str) -> str:
    if raw_target == LEGACY_ABOUT_INSTALLATION_ALIAS:
        return ABOUT_INSTALLATION_TARGET
    return raw_target


def compute_page_sequence(
    section_page_counts: dict[str, int],
) -> dict[str, tuple[int, ...]]:
    section_order = ["cover", ABOUT_INSTALLATION_TARGET, "technical-details", "menu", "special-thanks", "contact"]
    result: dict[str, tuple[int, ...]] = {}
    current_page = 1
    for section in section_order:
        count = section_page_counts.get(section, 0)
        if count > 0:
            result[section] = tuple(range(current_page, current_page + count))
            current_page += count
    return result


def markdown_article(doc_path: Path) -> Tag:
    html = markdown.markdown(doc_path.read_text(encoding="utf-8"), extensions=["tables", "fenced_code"])
    soup = BeautifulSoup(f"<article>{html}</article>", "html.parser")
    article = soup.find("article")
    if article is None:
        raise SystemExit(f"ERROR: could not render markdown article for {doc_path}")

    for img in article.find_all("img"):
        src = img.get("src", "")
        if src and not urlparse(src).scheme and not src.startswith("#"):
            img["src"] = (doc_path.parent / src).resolve().as_uri()
    return article


def clone_tag(tag: Tag) -> Tag:
    soup = BeautifulSoup(str(tag), "html.parser")
    clone = next((node for node in soup.contents if isinstance(node, Tag)), None)
    if clone is None:
        raise SystemExit(f"ERROR: could not clone tag: {tag.name}")
    return clone


def strip_ids(tag: Tag) -> None:
    for node in [tag, *tag.find_all(True)]:
        node.attrs.pop("id", None)


def append_html_fragment(parent: Tag, html: str) -> None:
    fragment = BeautifulSoup(html, "html.parser")
    for node in list(fragment.contents):
        parent.append(node)


def convert_code_to_mono(tag: Tag) -> None:
    for code in tag.find_all("code"):
        code.name = "span"
        code["class"] = ["mono"]


def template_soup(template_path: Path, *, replacements: dict[str, str] | None = None) -> BeautifulSoup:
    html = template_path.read_text(encoding="utf-8")
    if replacements:
        for placeholder, value in replacements.items():
            html = html.replace(placeholder, value)
    html = apply_interior_template_tokens(html)
    return BeautifulSoup(html, "html.parser")


def inject_margin_box_page_numbers(soup: BeautifulSoup, *, page_numbers: tuple[int, ...]) -> None:
    head = soup.head
    if head is None:
        raise SystemExit("ERROR: template has no <head> for page-number injection.")

    style = soup.new_tag("style")
    style.string = """
.page-number {
  display: none !important;
}
"""
    head.append(style)


def populate_about_installation_code_highlight(soup: BeautifulSoup, code: Tag) -> None:
    if code.get_text(strip=True) != 'nuke.pluginAddPath("Your/NukeSurvivalToolkit/FolderPath/Here")':
        return

    code.clear()
    code.attrs.pop("class", None)
    tokens = (
        ("py-module", "nuke"),
        ("py-punct", "."),
        ("py-func", "pluginAddPath"),
        ("py-punct", "("),
        ("py-string", '"Your/NukeSurvivalToolkit/FolderPath/Here"'),
        ("py-punct", ")"),
    )
    for class_name, text in tokens:
        span = soup.new_tag("span", **{"class": class_name})
        span.string = text
        code.append(span)


def style_about_installation_content(soup: BeautifulSoup, tag: Tag) -> None:
    for img in tag.find_all("img"):
        classes = list(img.get("class", []))
        if "toolbar-icon" not in classes:
            classes.append("toolbar-icon")
        img["class"] = classes

    for code in tag.find_all("code"):
        if code.parent is not None and code.parent.name == "pre":
            populate_about_installation_code_highlight(soup, code)


def about_installation_html() -> str:
    article = markdown_article(INTRO_DOC)
    children = [node for node in article.children if isinstance(node, Tag)]
    if not children:
        raise SystemExit("ERROR: intro markdown has no content.")

    soup = template_soup(
        ABOUT_INSTALLATION_TEMPLATE,
        replacements={
            "__TOOLBAR_ICON_URI__": TOOLBAR_ICON.resolve().as_uri(),
            "__JETBRAINS_MONO_REGULAR_URI__": JETBRAINS_MONO_REGULAR.resolve().as_uri(),
        },
    )
    body = soup.body
    if body is None:
        raise SystemExit("ERROR: about-installation template has no <body>.")
    body.clear()

    for child in children:
        child_clone = clone_tag(child)
        strip_ids(child_clone)
        style_about_installation_content(soup, child_clone)
        body.append(child_clone)

    page_number_node = soup.new_tag("div", **{"class": "page-number"})
    page_number_node.string = "2"
    body.append(page_number_node)
    inject_margin_box_page_numbers(soup, page_numbers=(2,))
    return str(soup)


def build_cover(*, version: str, output_path: Path, playwright_python: str, verbose: bool, stamp_numbers: bool = True) -> Path:
    with tempfile.TemporaryDirectory(prefix="nst-make-wiki-cover.") as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        html_path = build_merged_html(temp_dir, version=version, nav=[{"Home": "index.md"}], verbose=verbose)
        keep_articles(html_path, keep_ids={"doc-cover"})
        render_html_to_pdf(
            html_path,
            output_path,
            css_path=PDF_BROWSER_CSS,
            playwright_python=playwright_python,
            verbose=verbose,
        )
    if stamp_numbers:
        return stamp_page_numbers(
            output_path,
            first_page_index=1,
            last_page_index=1,
            start_number=1,
            playwright_python=playwright_python,
            verbose=verbose,
        )
    return output_path


def build_about_installation(
    *,
    output_path: Path,
    playwright_python: str,
    verbose: bool,
    stamp_numbers: bool = True,
) -> Path:
    render_standalone_html(
        about_installation_html(),
        temp_prefix="nst-make-wiki-about-installation.",
        filename="about-installation.html",
        output_path=output_path,
        playwright_python=playwright_python,
        verbose=verbose,
    )
    if stamp_numbers:
        return stamp_page_numbers(
            output_path,
            first_page_index=1,
            last_page_index=1,
            start_number=2,
            playwright_python=playwright_python,
            verbose=verbose,
        )
    return output_path


def technical_nested_item(soup: BeautifulSoup, nested_li: Tag, nested_index: int, *, style: str) -> Tag:
    wrapper = soup.new_tag("div", **{"class": "subitem" if style == "alpha" else "numeric-subitem"})
    marker = soup.new_tag("div", **{"class": "submarker"})
    marker.string = f"{chr(ord('a') + nested_index - 1)}.)" if style == "alpha" else f"{nested_index}.)"
    content = soup.new_tag("div", **{"class": "subcontent"})
    wrapper.append(marker)
    wrapper.append(content)

    has_block_children = any(
        isinstance(child, Tag) and child.name in {"p", "ol", "ul"}
        for child in nested_li.children
    )
    if not has_block_children:
        paragraph = soup.new_tag("p")
        append_html_fragment(paragraph, nested_li.decode_contents())
        convert_code_to_mono(paragraph)
        content.append(paragraph)
        return wrapper

    for child in [node for node in nested_li.children if isinstance(node, Tag)]:
        if child.name == "p":
            paragraph = clone_tag(child)
            strip_ids(paragraph)
            convert_code_to_mono(paragraph)
            content.append(paragraph)
        elif child.name in {"ol", "ul"}:
            paragraph = soup.new_tag("p")
            paragraph.string = child.get_text(" ", strip=True)
            content.append(paragraph)
        else:
            block = clone_tag(child)
            strip_ids(block)
            convert_code_to_mono(block)
            content.append(block)
    return wrapper


def technical_item(soup: BeautifulSoup, li: Tag, item_number: int) -> Tag:
    item = soup.new_tag("div", **{"class": "item"})
    marker = soup.new_tag("div", **{"class": "marker"})
    marker.string = f"{item_number}.)"
    content = soup.new_tag("div", **{"class": "content"})
    item.append(marker)
    item.append(content)

    for child in [node for node in li.children if isinstance(node, Tag)]:
        if child.name == "p":
            paragraph = clone_tag(child)
            strip_ids(paragraph)
            convert_code_to_mono(paragraph)
            content.append(paragraph)
        elif child.name == "ol":
            nested_style = "alpha" if item_number in {1, 4} else "numeric"
            nested_items = child.find_all("li", recursive=False)
            trailing_paragraph: Tag | None = None
            if item_number == 4 and nested_items:
                last_nested = nested_items[-1]
                direct_paragraphs = last_nested.find_all("p", recursive=False)
                if len(direct_paragraphs) > 1:
                    trailing_paragraph = clone_tag(direct_paragraphs[-1])
                    strip_ids(trailing_paragraph)
                    convert_code_to_mono(trailing_paragraph)
                    trailing_paragraph["class"] = ["tight"]
                    direct_paragraphs[-1].extract()

            for nested_index, nested_li in enumerate(nested_items, 1):
                content.append(technical_nested_item(soup, nested_li, nested_index, style=nested_style))

            if item_number == 1:
                last_paragraph = next(
                    (node for node in reversed(content.find_all("p", recursive=False))),
                    None,
                )
                if last_paragraph is not None:
                    last_paragraph["class"] = ["callout"]
            if trailing_paragraph is not None:
                content.append(trailing_paragraph)
        else:
            block = clone_tag(child)
            strip_ids(block)
            convert_code_to_mono(block)
            content.append(block)

    return item


def technical_details_html() -> str:
    article = markdown_article(TECHNICAL_DETAILS_DOC)
    title = article.find("h1", recursive=False)
    intro = article.find("p", recursive=False)
    top_list = article.find("ol", recursive=False)
    if title is None or intro is None or top_list is None:
        raise SystemExit("ERROR: technical details markdown is missing required structure.")

    items = top_list.find_all("li", recursive=False)
    if not items:
        raise SystemExit("ERROR: technical details ordered list contains no items.")

    soup = template_soup(
        TECHNICAL_DETAILS_TEMPLATE,
        replacements={"__JETBRAINS_MONO_REGULAR_URI__": JETBRAINS_MONO_REGULAR.resolve().as_uri()},
    )
    body = soup.body
    if body is None:
        raise SystemExit("ERROR: technical details template has no <body>.")
    body.clear()

    flow_style = soup.new_tag("style")
    flow_style.string = f"""
.spacer-page {{
  break-after: page;
  page-break-after: always;
  visibility: hidden;
  height: 1px;
}}

.flow-main {{
  padding: 10px 54px 0 54px;
}}

.flow-main .item,
.flow-main .subitem,
.flow-main .numeric-subitem {{
  break-inside: avoid;
  page-break-inside: avoid;
}}
"""
    body.append(flow_style)

    for _ in range(TECHNICAL_DETAILS_CONTEXT_PAGES):
        spacer = soup.new_tag("div", **{"class": "spacer-page"})
        spacer.string = "."
        body.append(spacer)

    flow_main = soup.new_tag("main", **{"class": "flow-main"})

    title_clone = clone_tag(title)
    strip_ids(title_clone)
    flow_main.append(title_clone)

    intro_clone = clone_tag(intro)
    strip_ids(intro_clone)
    flow_main.append(intro_clone)

    for item_number, item_li in enumerate(items, 1):
        flow_main.append(technical_item(soup, item_li, item_number))

    body.append(flow_main)

    return str(soup)


