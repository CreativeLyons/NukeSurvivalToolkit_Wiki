def output_path_for(target: str, output_dir: Path, *, artifact_version: int) -> Path:
    filename = {
        "cover": f"nst_wiki_cover_v{artifact_version}.pdf",
        "page2": f"nst_wiki_page2_v{artifact_version}.pdf",
        "technical-details": f"nst_wiki_technical_details_v{artifact_version}.pdf",
        "menu": f"nst_wiki_menu_v{artifact_version}.pdf",
        "contact": f"nst_wiki_contact_v{artifact_version}.pdf",
        "special-thanks": f"nst_wiki_special_thanks_v{artifact_version}.pdf",
        "pages-1-2": f"nst_wiki_v{artifact_version}.pdf",
        "pages-1-5": f"nst_wiki_v{artifact_version}.pdf",
        "full-so-far": f"nst_wiki_v{artifact_version}.pdf",
    }[target]
    return output_dir / filename


def open_pdf(path: Path) -> None:
    run(["open", str(path)])


def main() -> int:
    args = parse_args()
    target = args.target
    output_dir = Path(args.output_dir).resolve()
    output_dir.mkdir(parents=True, exist_ok=True)

    if target in PLANNED_TARGETS:
        print(f"Target '{target}' is planned but not implemented yet.")
        print(f"Implemented targets: {', '.join(sorted(IMPLEMENTED_TARGETS))}")
        return 2

    if target not in IMPLEMENTED_TARGETS:
        print(f"Unknown target: {target}", file=sys.stderr)
        print(f"Implemented targets: {', '.join(sorted(IMPLEMENTED_TARGETS))}", file=sys.stderr)
        return 2

    playwright_python = find_playwright_python()
    output_path = output_path_for(target, output_dir, artifact_version=args.artifact_version)

    builders = {
        "cover": lambda: build_cover(
            version=args.version, output_path=output_path,
            playwright_python=playwright_python, verbose=args.verbose,
        ),
        "page2": lambda: build_page2(
            version=args.version, output_path=output_path,
            playwright_python=playwright_python, verbose=args.verbose,
        ),
        "technical-details": lambda: build_technical_details(
            version=args.version, output_path=output_path,
            playwright_python=playwright_python, verbose=args.verbose,
        ),
        "menu": lambda: build_menu(
            version=args.version, output_path=output_path,
            playwright_python=playwright_python, verbose=args.verbose,
        ),
        "contact": lambda: build_contact(
            version=args.version, output_path=output_path,
            playwright_python=playwright_python, verbose=args.verbose,
        ),
        "special-thanks": lambda: build_special_thanks(
            version=args.version, output_path=output_path,
            playwright_python=playwright_python, verbose=args.verbose,
        ),
        "pages-1-2": lambda: build_pages_1_2(
            version=args.version, output_path=output_path,
            playwright_python=playwright_python, verbose=args.verbose,
        ),
        "pages-1-5": lambda: build_pages_1_5(
            version=args.version, output_path=output_path,
            playwright_python=playwright_python, verbose=args.verbose,
        ),
        "full-so-far": lambda: build_full_so_far(
            version=args.version, output_path=output_path,
            playwright_python=playwright_python, verbose=args.verbose,
        ),
    }

    builders[target]()

    print(output_path)
    if args.open:
        open_pdf(output_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
