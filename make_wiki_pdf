def special_thanks_html(*, page_numbers: tuple[int, int]) -> str:
    article = markdown_article(SPECIAL_THANKS_DOC)
    children = [node for node in article.children if isinstance(node, Tag)]
    if not children or children[0].name != "h1":
        raise SystemExit("ERROR: special thanks markdown must start with an H1.")

    title = children[0]
    contributors_heading_index = next(
        (index for index, node in enumerate(children) if node.name == "h2"),
        None,
    )
    if contributors_heading_index is None:
        raise SystemExit("ERROR: special thanks markdown is missing the contributors heading.")

    intro_paragraphs = children[1:contributors_heading_index]
    tail = children[contributors_heading_index + 1 :]
    if len(intro_paragraphs) != 4 or len(tail) < 6 or tail[1].name != "ul":
        raise SystemExit("ERROR: special thanks markdown does not match the expected structure.")

    contributors_intro = tail[0]
    contributors_list = tail[1]
    remaining_paragraphs = tail[2:]

    soup = template_soup(SPECIAL_THANKS_TEMPLATE)
    pages = soup.find_all("section", class_="page")
    if len(pages) != 2:
        raise SystemExit("ERROR: special thanks template must contain two pages.")

    first_content = pages[0].find("div", class_="content")
    second_content = pages[1].find("div", class_="content")
    if first_content is None or second_content is None:
        raise SystemExit("ERROR: special thanks template content containers are missing.")

    first_content.clear()
    title_clone = clone_tag(title)
    strip_ids(title_clone)
    first_content.append(title_clone)
    for paragraph in intro_paragraphs:
        paragraph_clone = clone_tag(paragraph)
        strip_ids(paragraph_clone)
        first_content.append(paragraph_clone)

    second_content.clear()
    intro_clone = clone_tag(contributors_intro)
    strip_ids(intro_clone)
    intro_clone["class"] = ["contributors-intro"]
    second_content.append(intro_clone)

    contributors = soup.new_tag("p", **{"class": "contributors"})
    names = [li.get_text(" ", strip=True) for li in contributors_list.find_all("li", recursive=False)]
    for index, name in enumerate(names):
        strong = soup.new_tag("strong")
        strong.string = name
        contributors.append(strong)
        contributors.append(soup.new_tag("br"))
    contributors.append(NavigableString(remaining_paragraphs[0].get_text(" ", strip=True)))
    second_content.append(contributors)

    for paragraph in remaining_paragraphs[1:3]:
        paragraph_clone = clone_tag(paragraph)
        strip_ids(paragraph_clone)
        second_content.append(paragraph_clone)

    credit_clone = clone_tag(remaining_paragraphs[3])
    strip_ids(credit_clone)
    credit_clone["class"] = ["credit"]
    second_content.append(credit_clone)

    page_number_nodes = soup.find_all("div", class_="page-number")
    if len(page_number_nodes) == 2:
        page_number_nodes[0].string = str(page_numbers[0])
        page_number_nodes[1].string = str(page_numbers[1])

    inject_margin_box_page_numbers(soup, page_numbers=page_numbers)
    return str(soup)


