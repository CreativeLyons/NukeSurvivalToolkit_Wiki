def menu_html(*, page_number: int) -> str:
    article = markdown_article(MENU_DOC)
    title = article.find("h1", recursive=False)
    intro = article.find("p", recursive=False)
    table = article.find("table", recursive=False)
    if title is None or intro is None or table is None:
        raise SystemExit("ERROR: menu markdown is missing required structure.")

    headers = table.find_all("th")
    cells = table.find_all("td")
    if len(headers) != 2 or len(cells) != 2:
        raise SystemExit("ERROR: menu markdown table must contain two columns.")

    left_img = cells[0].find("img")
    right_img = cells[1].find("img")
    if left_img is None or right_img is None:
        raise SystemExit("ERROR: menu markdown table must contain both images.")

    soup = template_soup(
        MENU_TEMPLATE,
        replacements={
            "__NST_MENU_URI__": left_img["src"],
            "__NUKEPEDIA_MENU_URI__": right_img["src"],
            "__JETBRAINS_MONO_REGULAR_URI__": JETBRAINS_MONO_REGULAR.resolve().as_uri(),
        },
    )

    heading = soup.find("h1")
    if heading is not None:
        heading.string = title.get_text(strip=True)

    intro_node = soup.find("p", class_="intro")
    if intro_node is not None:
        intro_node.clear()
        append_html_fragment(intro_node, intro.decode_contents())

    captions = soup.find_all("p", class_="caption")
    if len(captions) == 2:
        captions[0].string = headers[0].get_text(" ", strip=True)
        captions[1].string = headers[1].get_text(" ", strip=True)

    page_number_node = soup.find("div", class_="page-number")
    if page_number_node is not None:
        page_number_node.string = str(page_number)

    inject_margin_box_page_numbers(soup, page_numbers=(page_number,))
    return str(soup)


